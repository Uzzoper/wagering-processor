# Application
PORT=3000

# PostgreSQL via docker-compose.yml (host port 5433 -> container 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering

# SQS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Fake LocalStack credentials (never real secrets)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_WAGER_QUEUE=wager-transactions.fifo
# Retry transitório no consumer (base 30s, teto 1h; limite SQS: 12h)
SQS_RETRY_BASE_DELAY_SECONDS=30
SQS_RETRY_MAX_DELAY_SECONDS=3600

# Workers (csv: api,outbox,sqs,pending) e outbox publisher
WORKERS_ENABLED=api,outbox,sqs,pending
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=60000

# Worker de PENDING_REFERENCE (backoff 30s -> teto 1h; TTL 24h)
# PENDING_REF_POLL_INTERVAL_MS=30000
# PENDING_REF_TTL_HOURS=24
# PENDING_REF_MAX_ATTEMPTS=20
