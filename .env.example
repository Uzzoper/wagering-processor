# Application
PORT=3000

# PostgreSQL via docker-compose.yml (host port 5433 -> container 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering

# SQS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Fake LocalStack credentials (never real secrets)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_EVENTS_QUEUE=wager-events.fifo

# Workers (csv: api,outbox) e outbox publisher
WORKERS_ENABLED=api,outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=60000
